# Supabase project ref (course-sns: pbyxnvtgsrwmsvxnynif)
# See docs/HANDOFF.md for setup notes and Vercel checklist.

# --- Supabase (required) ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Naver Cloud Maps (required for map UI + driving directions) ---
NEXT_PUBLIC_NAVER_MAP_KEY=your-ncp-maps-client-id
NAVER_MAP_CLIENT_SECRET=your-ncp-maps-client-secret

# --- Naver Search OpenAPI (optional — place keyword search in RouteForm) ---
# Without these, search UI is hidden; other features work normally.
NAVER_SEARCH_CLIENT_ID=
NAVER_SEARCH_CLIENT_SECRET=

# --- TMAP OpenAPI (optional — KR walking; transit fetch still TODO) ---
# Without this, walk/bike legs fall back to Naver *driving* roads (looks like a car route).
# See docs/routing/KR.md. Do not expect Naver Directions to return pedestrian paths.
TMAP_APP_KEY=

# --- ODsay (optional — KR transit lane graphics, alternative to TMAP Transit) ---
# docs/routing/KR.md C. Leave empty unless implementing ODsay.
ODSAY_API_KEY=

# --- Google Maps (overseas tiles + every spot-to-spot path) ---
# Separate from Naver/TMAP. Do not use these keys for Korea-only courses' tiles.
# Server Routes API (never NEXT_PUBLIC_): docs/routing/OVERSEAS.md
GOOGLE_MAPS_API_KEY=
# Browser Maps JavaScript API (HTTP referrer restricted):
NEXT_PUBLIC_GOOGLE_MAPS_KEY=

# --- Site URL (optional — OG/Twitter absolute image URLs in production) ---
# Defaults to VERCEL_URL on Vercel, http://localhost:3000 locally.
NEXT_PUBLIC_SITE_URL=

# --- Playwright E2E (optional — defaults to seeded demo account) ---
E2E_DEMO_EMAIL=demo@course-sns.app
E2E_DEMO_PASSWORD=demo1234
